# ==============================================================================
# CrumbDesk - Environment Configuration
# ==============================================================================
# All environment variables in CrumbDesk are SERVER-ONLY.
# Never prefix Ollama endpoints or server secrets with NEXT_PUBLIC_.
#
# Default values below work out-of-the-box for a standard local Ollama installation.

# Base URL where Ollama HTTP service is listening (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Locally downloaded open-weight model name (default: gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# Model inference timeout in milliseconds (default: 45000 = 45 seconds)
# Recommended: 45000 to 60000 on an 8 GB RAM laptop
OLLAMA_TIMEOUT_MS=45000
